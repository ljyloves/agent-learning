# Backend
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_DB=flowgate
POSTGRES_USER=flowgate
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change_me
REDIS_PORT=6379

# Qdrant
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_me
PAPER_AGENT_QUESTION_COLLECTION=paper_questions

# LLM (OpenAI-compatible: OpenAI / DeepSeek / Qwen / etc.)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# Paper Agent
PAPER_AGENT_MODEL=gpt-4o-mini
PAPER_AGENT_STORAGE_PATH=/app/storage/paper_agent
PAPER_AGENT_TEMPLATE_PATH=/app/templates/paper_agent
PAPER_AGENT_CHECKPOINT_POOL_MIN_SIZE=1
PAPER_AGENT_CHECKPOINT_POOL_MAX_SIZE=5
PAPER_AGENT_UPLOAD_MAX_BYTES=20971520
PAPER_AGENT_WEBPAGE_MAX_BYTES=5242880
PAPER_AGENT_WEB_TIMEOUT_SECONDS=15
PAPER_AGENT_ALLOWED_WEBSITE_HOSTS=openstax.org,www.openstax.org
PAPER_AGENT_RETRIEVAL_POOL_SIZE=500
PAPER_AGENT_TAXONOMY_WRITE_ENABLED=false

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-key-here
