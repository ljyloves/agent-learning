# Backend
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_DB=flowgate
POSTGRES_USER=flowgate
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change_me
REDIS_PORT=6379

# Qdrant
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_me

# LLM (OpenAI-compatible: OpenAI / DeepSeek / Qwen / etc.)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# Paper Agent
PAPER_AGENT_MODEL=gpt-4o-mini
PAPER_AGENT_STORAGE_PATH=/app/storage/paper_agent
PAPER_AGENT_TEMPLATE_PATH=/app/templates/paper_agent

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-key-here
